{
 "id": "socso-skbbk",
 "description": "Non-Employment Injury Scheme (Skim Kemalangan Bukan Bencana Kerja, SKBBK, branded 'LINDUNG 24 Jam') employee-only contribution per wage band and phase. Same amount for First and Second Category. Employer pays nothing for this scheme. Wage ceiling RM6,000.",
 "legalBasis": "Employees' Social Security Act 1969 [Act 4] as amended by Act A1788 (royal assent 23 Feb 2026, gazetted 5 Mar 2026); s.6(2),(4),(5),(11) and Third Schedule Parts I-VI; s.9(3)-(4) (one employer only); commencement and phase dates by P.U.(B) 196/2026; employer-selection procedure by P.U.(A) 206/2026 reg 12B. Voluntary status for locals rests on the Cabinet decision of 8 Jul 2026 and a signed liability release; no gazetted instrument found as of 2026-11-05, partly on saved AGC portal listings, use pending owner decision.",
 "effectiveFrom": "2026-06-01",
 "lookup": "Band i applies when wageAbove < monthlyWage <= wageUpTo (wageUpTo null = open-ended top band). Band 1 is 'wages up to RM30'. All amounts in RM. Wage ceiling RM6,000: bands 64 and 65 carry identical amounts. Top NEI amount starts ABOVE RM5,900 in phase 1: exactly RM5,900.00 is band 63 = RM43.85; RM5,900.01 and up = RM44.65.",
 "phases": [
  {
   "phase": 1,
   "effectiveFrom": "2026-06-01",
   "effectiveTo": "2028-05-31",
   "nominalRate": 0.0075
  },
  {
   "phase": 2,
   "effectiveFrom": "2028-06-01",
   "effectiveTo": "2031-05-31",
   "nominalRate": 0.01
  },
  {
   "phase": 3,
   "effectiveFrom": "2031-06-01",
   "effectiveTo": null,
   "nominalRate": 0.0125
  }
 ],
 "participation": {
  "2026-06": "mandatory for all Act 4 employees (local and foreign), no refund",
  "from2026-07-08": "voluntary for local employees (opt-out model); mandatory for foreign workers",
  "optOutWindow": {
   "from": "2026-07-13",
   "to": "2026-08-31"
  },
  "afterWindow": "no further opt-out; locals who did not opt out are permanently in ('once in, always in'); opted-out locals may opt in at any time, online from 2 Sep 2026 (contribution due on the full month's wage for the month of opt-in, not backdated); first-time contributors must contribute per PERKESO FAQ v2.3 Q26, Q27, Q29, though earlier PERKESO documents described a new-hire opt-out, so existing new-hire opt-outs may be valid (medium confidence)",
  "multipleEmployers": "NEI contribution is paid through at most ONE employer (s.9(3) Act 4 as amended): zero if an opted-out local, otherwise one, on that employer's band. The employee chooses within 30 days from the date PERKESO furnishes written notice, whenever they have two or more employers (P.U.(A) 206/2026 reg 12B; Circular 3/2026 paras 4.5, 4.7, 4.9). Failing that, PERKESO notifies the employer within 14 days."
 },
